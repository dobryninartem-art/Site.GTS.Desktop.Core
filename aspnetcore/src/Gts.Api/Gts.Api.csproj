<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- LTS. При желании можно поднять до net10.0, когда закрепитесь на нём. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gts.Api</RootNamespace>
    <UserSecretsId>5b300c50-66c8-48de-becc-020ffdf4b271</UserSecretsId>
    <!-- Исходники ведём в UTF-8, в отличие от legacy (Windows-1251). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Современный SQL-клиент (замена System.Data.SqlClient из .NET Framework). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- OpenAPI/Swagger — то, чего принципиально не было у ASMX. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
